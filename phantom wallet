<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Phantom" />
<meta name="theme-color" content="#000000" />
<link id="apple-touch-icon" rel="apple-touch-icon" />
<link id="manifest-link" rel="manifest" />
<title>Phantom</title>
<style>
  :root {
    --bg: #000000;
    --card: #161618;
    --card-2: #1f1f23;
    --card-border: rgba(255, 255, 255, 0.06);
    --lavender: #AB9FF2;
    --lavender-dim: rgba(171, 159, 242, 0.16);
    --green: #30D158;
    --green-bg: rgba(48, 209, 88, 0.16);
    --red: #FF453A;
    --text: #FFFFFF;
    --muted: #8E8E93;
    --safe-top: env(safe-area-inset-top, 20px);
    --safe-bottom: env(safe-area-inset-bottom, 20px);
  }

  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", sans-serif;
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    font-variant-numeric: tabular-nums;
  }

  /* Splash Screen */
  #splash {
    position: fixed;
    inset: 0;
    background: var(--lavender);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.45s ease, visibility 0.45s ease;
  }
  #splash.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* App Container */
  #app {
    max-width: 430px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    background: var(--bg);
  }

  /* Top Header */
  .top-header {
    padding: calc(var(--safe-top) + 8px) 16px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 20;
  }

  .avatar-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #87CEEB;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    border: 1.5px solid rgba(255,255,255,0.12);
    cursor: pointer;
  }

  .nav-pills {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-pill {
    border: none;
    background: var(--card);
    color: var(--muted);
    font-size: 15px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .nav-pill.active {
    background: var(--lavender);
    color: #000000;
  }

  /* Scrollable Content */
  .scroll-view {
    flex: 1;
    overflow-y: auto;
    padding: 6px 16px calc(var(--safe-bottom) + 92px);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .scroll-view::-webkit-scrollbar { display: none; }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* Home Tab */
  .account-row {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
    margin-top: 6px;
    cursor: pointer;
  }

  .hero-balance {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -1.2px;
    margin: 4px 0 6px;
    line-height: 1.08;
  }

